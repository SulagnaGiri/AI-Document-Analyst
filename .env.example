# Copy to .env and fill in. Never put real keys in this file: it is committed to git.

# --- Primary: Google Gemini ---
# One key, or several separated by commas (rotated automatically when one hits a rate limit).
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2
# GEMINI_MODEL=gemini-3.5-flash

# --- Backup: NVIDIA NIM (used when Gemini fails, stalls or is not configured) ---
NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Optional ---
# LLM_PROVIDER=nvidia        # put NVIDIA first instead of Gemini
# LLM_TIMEOUT=35             # seconds to wait for one model reply before trying the next
# PORT=5001
