# AI Document Analyst Configuration Example

# Active Model Selection
# Options: "donut" (Hugging Face Donut DocVQA), "nvidia" (Nemotron Reasoning LLM), or "rules"
MODEL_PROVIDER=donut

# Hugging Face Configuration (Donut Base DocVQA)
# Model card: https://huggingface.co/naver-clova-ix/donut-base-finetuned-docvqa
DONUT_MODEL=naver-clova-ix/donut-base-finetuned-docvqa
DONUT_API_URL=https://api-inference.huggingface.co/models/naver-clova-ix/donut-base-finetuned-docvqa
# Optional: Hugging Face User Access Token (from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# NVIDIA NIM / LLM Configuration (Optional)
# NVIDIA API key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_key_here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Server Configuration
PORT=5001
FLASK_ENV=development
