# --- Primary: Google Gemini Configuration ---
# You can provide multiple keys separated by commas for automatic round-robin and rate-limit failover:
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3
# Or a single key:
# GEMINI_API_KEY=your_gemini_key
# Model choice: gemini-2.5-flash (fast, reasoning, 1M context), gemini-1.5-flash, gemini-2.5-pro, etc.
GEMINI_MODEL=gemini-2.5-flash

# --- Alternative: NVIDIA NIM Configuration ---
# NVIDIA_API_KEY=your_nvidia_api_key
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# --- Server Configuration ---
PORT=5001
